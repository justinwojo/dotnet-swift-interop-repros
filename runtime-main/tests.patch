+    [UnmanagedCallersOnly(CallConvs = [typeof(CallConvSwift)])]
+    private static unsafe int ConditionallySetErrorAndReturnErrorLast(int value, int setError, SwiftError* error)
+    {
+        // Report misplaced arguments through the return value instead of writing through
+        // an argument that may not be the SwiftError*.
+        if (setError != 0 && setError != 1)
+        {
+            return -1;
+        }
+
+        if (setError != 0)
+        {
+            *error = new SwiftError((void*)value);
+        }
+        else
+        {
+            *error = new SwiftError(null);
+        }
+
+        return (value * 2);
+    }
