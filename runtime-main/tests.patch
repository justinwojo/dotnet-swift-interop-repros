+
+        retValue = NativeFunctionWithCallbackErrorLast(expectedValue, 1, &ConditionallySetErrorAndReturnErrorLast, &error);
+
+        Assert.Equal(expectedValue * 2, retValue);
+        Assert.Equal(expectedValue, (int)error.Value);
